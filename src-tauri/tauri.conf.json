{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XASMA Beat Release Manager",
  "version": "2.0.0",
  "identifier": "io.xasmabeats.release-manager",
  "build": {
    "beforeDevCommand": "npm run dev -- --mode desktop --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "windows": [{ "label":"main", "title":"XASMA Beat Release Manager", "width":1280, "height":900, "minWidth":800, "minHeight":600, "dragDropEnabled":true }],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "assetProtocol": { "enable":true, "scope":["$APPLOCALDATA/media/**", "$APPLOCALDATA/outputs/**"] }
    }
  },
  "bundle": {
    "active":true,
    "targets":["nsis"],
    "icon":["icons/icon.ico", "icons/128x128.png"],
    "resources": {"resources/media-tools/":"media-tools/"},
    "windows": {
      "webviewInstallMode":{"type":"downloadBootstrapper","silent":true},
      "nsis":{"installMode":"currentUser", "displayLanguageSelector":false, "languages":["English"]}
    }
  }
}
